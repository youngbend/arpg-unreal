# Normalise line endings for text; everything matched by an LFS rule below is
# force-marked binary with -text so git never rewrites it.
* text=auto

# --- Unreal assets -----------------------------------------------------------
# These are the reason LFS exists here: a single .uasset re-save is a full new
# blob, so keeping them in regular git history bloats the repo permanently.
#
# NOTE: to enable exclusive checkout for a team, append `lockable` to the
# .uasset/.umap lines and use `git lfs lock`. Left off deliberately — it makes
# every asset read-only until locked, which is pure friction for a solo dev.
*.uasset  filter=lfs diff=lfs merge=lfs -text
*.umap    filter=lfs diff=lfs merge=lfs -text
*.upk     filter=lfs diff=lfs merge=lfs -text
*.udk     filter=lfs diff=lfs merge=lfs -text

